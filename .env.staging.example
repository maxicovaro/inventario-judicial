# Staging debe conservar las protecciones de production.
NODE_ENV=production
DEPLOY_ENV=staging
DEPLOY_REVISION=reemplazar_por_commit_o_version

# Railway inyecta PORT automáticamente. Mantener 3000 solo fuera de Railway si hace falta.
PORT=3000

# Origen HTTPS exacto del frontend público de staging, sin barra/ruta adicional.
CORS_ORIGIN=https://inventario-staging.up.railway.app

# MySQL exclusivo de staging. En Railway usar Reference Variables del servicio mysql.
DB_HOST=mysql-staging.example.internal
DB_PORT=3306
DB_NAME=inventario_judicial_staging
DB_USER=inventario_staging
DB_PASSWORD=reemplazar_por_secreto_staging

# Guarda no secreta: debe contener el nombre de la base de producción para
# impedir que el preflight acepte por error la misma DB en staging.
PRODUCTION_DB_NAME=inventario_judicial

JWT_SECRET=reemplazar_por_secreto_aleatorio_de_al_menos_32_bytes
AUTH_TOKEN_TRANSPORT=cookie

# Topología Railway P7.2: navegador -> Caddy frontend -> backend privado.
# Express confía exactamente en ese proxy de aplicación.
TRUST_PROXY_HOPS=1

LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=20

REQUIRE_ADMIN_MFA=true
MFA_ISSUER=Inventario Judicial - Staging
MFA_RATE_LIMIT_WINDOW_MS=600000
MFA_RATE_LIMIT_MAX=10
# Base64 de exactamente 32 bytes. Generar un secreto exclusivo de staging.
MFA_ENCRYPTION_KEY=reemplazar_por_clave_base64_de_32_bytes

# Railway Volume montado en /data. Los adjuntos viven en un subdirectorio persistente.
UPLOAD_DIR=/data/uploads

HEALTH_DB_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Con proxy same-origin, API y frontend comparten el mismo origen público.
SMOKE_API_ORIGIN=https://inventario-staging.up.railway.app
SMOKE_FRONTEND_ORIGIN=https://inventario-staging.up.railway.app
SMOKE_TIMEOUT_MS=5000
