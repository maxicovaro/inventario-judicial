# Staging debe conservar las protecciones de production.
NODE_ENV=production
DEPLOY_ENV=staging
# Railway usa DEPLOY_REVISION; Render puede derivarla automáticamente de RENDER_GIT_COMMIT.
DEPLOY_REVISION=reemplazar_por_commit_o_version
# external-free = web full-stack dormible + DB MySQL-compatible externa + bucket privado.
# STAGING_TOPOLOGY=external-free
# SERVE_FRONTEND_STATIC=true
# FRONTEND_DIST_DIR=inventario-frontend/dist
PORT=3000

# Origen HTTPS exacto del frontend de staging, sin barra/ruta adicional.
CORS_ORIGIN=https://inventario-staging.example.invalid

# MySQL exclusivo de staging. No usar datos ni credenciales de producción.
DB_HOST=mysql-staging.example.internal
DB_PORT=3306
DB_NAME=inventario_judicial_staging
DB_USER=inventario_staging
DB_PASSWORD=reemplazar_por_secreto_staging
# Para TiDB Cloud Starter / conexiones MySQL externas seguras:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Guarda no secreta: debe contener el nombre de la base de producción para
# impedir que el preflight acepte por error la misma DB en staging.
PRODUCTION_DB_NAME=inventario_judicial

JWT_SECRET=reemplazar_por_secreto_aleatorio_de_al_menos_32_bytes
AUTH_TOKEN_TRANSPORT=cookie

# Definir explícitamente según la topología real. 0 = cliente directo;
# 1 = un reverse proxy confiable; no adivinar este valor.
TRUST_PROXY_HOPS=0

LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=20

REQUIRE_ADMIN_MFA=true
MFA_ISSUER=Inventario Judicial - Staging
MFA_RATE_LIMIT_WINDOW_MS=600000
MFA_RATE_LIMIT_MAX=10
# Base64 de exactamente 32 bytes. Generar un secreto exclusivo de staging.
MFA_ENCRYPTION_KEY=reemplazar_por_clave_base64_de_32_bytes

# H1: staging Free usa bucket privado para adjuntos y conserva un único Volume para MySQL.
UPLOAD_STORAGE_MODE=s3
UPLOAD_S3_ENDPOINT=https://storage-staging.example.invalid
UPLOAD_S3_BUCKET=reemplazar_por_bucket_staging
UPLOAD_S3_REGION=auto
UPLOAD_S3_ACCESS_KEY_ID=reemplazar_por_reference_variable
UPLOAD_S3_SECRET_ACCESS_KEY=reemplazar_por_reference_variable
UPLOAD_S3_PREFIX=uploads/staging
UPLOAD_S3_FORCE_PATH_STYLE=false

HEALTH_DB_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Variables de smoke post-deploy. Deben ser orígenes HTTPS sin ruta.
SMOKE_API_ORIGIN=https://api-inventario-staging.example.invalid
SMOKE_FRONTEND_ORIGIN=https://inventario-staging.example.invalid
SMOKE_TIMEOUT_MS=5000
