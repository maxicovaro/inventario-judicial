NODE_ENV=development
# Etiqueta operativa independiente de NODE_ENV.
# En staging usar DEPLOY_ENV=staging junto con NODE_ENV=production.
DEPLOY_ENV=development
# Commit SHA o versión exacta desplegada. Obligatoria en deploy:preflight.
# DEPLOY_REVISION=

PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventario_judicial
DB_USER=usuario_mysql
DB_PASSWORD=cambiar_por_una_clave_segura

# En staging, deploy:preflight exige declarar el nombre de la DB de producción
# y rechaza que coincida con DB_NAME.
# PRODUCTION_DB_NAME=inventario_judicial

JWT_SECRET=cambiar_por_un_secreto_largo_aleatorio

# Transporte de autenticación.
# development/test: hybrid mantiene compatibilidad temporal con Bearer + cookie HttpOnly.
# staging/production: debe ser cookie porque NODE_ENV=production.
AUTH_TOKEN_TRANSPORT=hybrid

# Si la app corre detrás de un reverse proxy confiable, definir la cantidad exacta de saltos.
# Mantener 0 si Express recibe directamente al cliente.
TRUST_PROXY_HOPS=0

# Protección contra fuerza bruta por IP en /api/auth/login.
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=20

# MFA: con NODE_ENV=production los administradores lo requieren por defecto.
REQUIRE_ADMIN_MFA=false
MFA_ISSUER=Inventario Judicial
MFA_RATE_LIMIT_WINDOW_MS=600000
MFA_RATE_LIMIT_MAX=10
# Generar una clave aleatoria de 32 bytes y guardarla en Base64. Obligatoria en production.
# MFA_ENCRYPTION_KEY=

# Directorio persistente de adjuntos. Vacío conserva storage/uploads en local.
# En Railway staging se usará /data/uploads sobre un Volume.
# UPLOAD_DIR=

# Resiliencia operativa
HEALTH_DB_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Smoke test post-deploy (P7). En staging/production deben ser HTTPS.
# SMOKE_API_ORIGIN=https://api-staging.ejemplo
# SMOKE_FRONTEND_ORIGIN=https://staging.ejemplo
# SMOKE_TIMEOUT_MS=5000

# Restauración segura: usar una base alternativa por defecto.
# RESTORE_DB_HOST=localhost
# RESTORE_DB_PORT=3306
# RESTORE_DB_NAME=inventario_restore
# RESTORE_DB_USER=usuario_con_permisos_de_restore
# RESTORE_DB_PASSWORD=cambiar_por_una_clave_segura
# ALLOW_RESTORE_CURRENT_DB=false

# Solo para crear el primer administrador de forma explícita:
# BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.local
# BOOTSTRAP_ADMIN_PASSWORD=UsarUnaClave#MuyFuerte2026
# BOOTSTRAP_ADMIN_NOMBRE=Administrador
# BOOTSTRAP_ADMIN_APELLIDO=General
